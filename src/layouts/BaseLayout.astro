---
import BaseHeader from "../components/BaseHeader.astro";
import BaseFooter from "../components/BaseFooter.astro";
import BarryAllen from "../components/BarryAllen.astro";
import BackToTop from "../components/BackToTop.astro";
import TerminalIsland from "../components/terminal/TerminalIsland";
import { getPosts } from "../lib/blog";

import {
  alternateLinks,
  formatDate,
  getLangFromUrl,
  localeTags,
  localizePath,
  ogLocales,
  terminalStrings,
  withBase,
  useTranslations,
} from "../i18n/utils";

import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/jetbrains-mono/400.css";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  fullWidth?: boolean;
  /** Passer à `true` pour retirer une page des moteurs de recherche. */
  noindex?: boolean;
};

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title,
  description = t("site.description"),
  fullWidth = false,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Les alternances de langue ne valent que pour une page indexable et réellement
// traduite. La 404 n'existe qu'une fois (GitHub Pages ne sert qu'un 404.html) :
// annoncer /en/404 pointerait vers une adresse qui n'est pas générée.
const alternates = noindex ? [] : alternateLinks(Astro.url, Astro.site);
const pageTitle = title ?? t("site.name");

// Les articles sont injectés dans la palette de commandes (Ctrl + K) pour
// qu'elle serve aussi de recherche dans le blog.
const posts = (await getPosts(lang)).map(({ entry, slug }) => ({
  title: entry.data.title,
  href: localizePath(lang, `/blog/${slug}`),
  tags: entry.data.tags,
  date: formatDate(entry.data.pubDate, lang, {
    month: "short",
    year: "numeric",
  }),
}));

// La palette est une île React : elle ne peut pas importer les dictionnaires
// côté serveur, on lui passe donc ses chaînes et les chemins déjà préfixés.
// Seules les clés qu'elle utilise partent dans le HTML.
const strings = terminalStrings(lang);

const terminalPaths = {
  home: localizePath(lang, "/"),
  now: localizePath(lang, "/now"),
  projects: localizePath(lang, "/projets"),
  blog: localizePath(lang, "/blog"),
  cv: localizePath(lang, "/cv"),
  changelog: localizePath(lang, "/changelog"),
  otherLang: localizePath(lang === "fr" ? "en" : "fr", Astro.url.pathname),
};
---

<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/favicon.ico")} sizes="any" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t("site.rssTitle")}
      href={localizePath(lang, "/rss.xml")}
    />

    {
      alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.hreflang}
          href={alternate.href}
        />
      ))
    }

    {
      alternates.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
      )
    }

    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[lang]} />

    {
      alternates
        .filter((alternate) => alternate.lang !== lang)
        .map((alternate) => (
          <meta property="og:locale:alternate" content={localeTags[alternate.lang].replace("-", "_")} />
        ))
    }

    <meta name="twitter:card" content="summary" />

    <script is:inline>
      const theme =
        localStorage.getItem("theme") ??
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");

      document.documentElement.classList.toggle("dark", theme === "dark");

      document.documentElement.classList.toggle(
        "miroir",
        localStorage.getItem("miroir") === "1",
      );

      const fontSizes = { sm: "15px", md: "16px", lg: "18px" };
      const fontSize = localStorage.getItem("fontSize") ?? "md";
      document.documentElement.style.fontSize =
        fontSizes[fontSize] ?? fontSizes.md;
    </script>
  </head>

  <body
    class="min-h-screen bg-white text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100 transition-colors flex flex-col"
  >
    <BaseHeader />

    {
      fullWidth ? (
        <main class="flex-1">
          <slot />
        </main>
      ) : (
        <main class="flex-1 flex items-center justify-center">
          <div class="w-full max-w-xl px-6">
            <slot />
          </div>
        </main>
      )
    }

    <BaseFooter />

    <BackToTop />

    <TerminalIsland
      client:load
      posts={posts}
      strings={strings}
      paths={terminalPaths}
    />

    <BarryAllen />

    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
    </script>
  </body>
</html>
