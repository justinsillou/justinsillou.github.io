---
import BaseHeader from "../components/BaseHeader.astro";
import BaseFooter from "../components/BaseFooter.astro";
import BarryAllen from "../components/BarryAllen.astro";
import BackToTop from "../components/BackToTop.astro";
import TerminalIsland from "../components/terminal/TerminalIsland";
import AidesBubble from "../components/AidesBubble.astro";
import "../styles/global.css";

const { title, fullWidth = false } = Astro.props;
---

<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title ?? "Justin Sillou"}</title>

    <meta
      name="description"
      content="Site en cours de refonte. Me retrouver sur GitHub et LinkedIn en attendant."
    />

    <meta name="robots" content="noindex" />

    <script is:inline>
      const theme =
        localStorage.getItem("theme") ??
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");

      document.documentElement.classList.toggle("dark", theme === "dark");

      const fontSizes = { sm: "15px", md: "16px", lg: "18px" };
      const fontSize = localStorage.getItem("fontSize") ?? "md";
      document.documentElement.style.fontSize = fontSizes[fontSize] ?? fontSizes.md;
    </script>
  </head>

  <body
    class="min-h-screen bg-white text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100 transition-colors flex flex-col"
  >
    <BaseHeader />

    {
      fullWidth ? (
        <main class="flex-1">
          <slot />
        </main>
      ) : (
        <main class="flex-1 flex items-center justify-center">
          <div class="w-full max-w-md px-6">
            <slot />
          </div>
        </main>
      )
    }

    <BaseFooter />

    <BackToTop />

    <TerminalIsland client:load />

    {/*<AidesBubble />*/}

    <BarryAllen />

    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
    </script>
   </body>
</html>