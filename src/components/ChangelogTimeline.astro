---
import { changelog } from "../content/changelog";
---

<div class="relative mt-10">
  <div
    class="absolute left-3 top-3 bottom-3 w-px bg-neutral-200 dark:bg-neutral-800"
  ></div>

  <div class="space-y-8">
    {changelog.map((entry, index) => (
      <article class="relative pl-10">
        <!-- Point sur la timeline -->
        <div
          class:list={[
            "absolute left-0 top-6 w-6 h-6 rounded-full border-4 border-white dark:border-neutral-950",
            index === 0
              ? "bg-neutral-900 dark:bg-neutral-100"
              : "bg-neutral-300 dark:bg-neutral-700",
          ]}
        ></div>

        <!-- Card -->
        <div
          class:list={[
            "rounded-xl border p-5 transition-colors",
            index === 0
              ? "border-neutral-300 dark:border-neutral-700"
              : "border-neutral-200 dark:border-neutral-800",
          ]}
        >
          <div class="flex items-center justify-between gap-4">
            <span class="font-mono text-sm font-medium">
              v{entry.version}
            </span>

            <time class="text-xs text-neutral-400">
              {entry.date}
            </time>
          </div>

          <h2 class="mt-3 text-base font-semibold">
            {entry.title}
          </h2>

          <ul class="mt-3 space-y-2 text-sm text-neutral-500 dark:text-neutral-400">
            {entry.changes.map((change) => (
              <li class="flex gap-2">
                <span class="text-neutral-300 dark:text-neutral-700">•</span>
                <span>{change}</span>
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</div>