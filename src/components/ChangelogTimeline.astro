---
import { getChangelog } from "../data/changelog";
import { formatDate, getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const entries = getChangelog(lang);
---

<div class="relative max-w-5xl">
  <div
    class="absolute left-4 top-4 bottom-4 w-px bg-neutral-200 dark:bg-neutral-800"
  >
  </div>

  <div class="space-y-10">
    {
      entries.map((entry, index) => (
        <article class="relative pl-14">
          <!-- Point sur la timeline -->
          <div
            class:list={[
              "absolute left-0 top-8 w-8 h-8 rounded-full border-4 border-white dark:border-neutral-950",
              index === 0
                ? "bg-neutral-900 dark:bg-neutral-100"
                : "bg-neutral-300 dark:bg-neutral-700",
            ]}
          />

          <!-- Card -->
          <div
            class:list={[
              "rounded-xl border p-6 lg:p-7 transition-colors",
              index === 0
                ? "border-neutral-300 dark:border-neutral-700"
                : "border-neutral-200 dark:border-neutral-800",
            ]}
          >
            <div class="flex items-center justify-between gap-4">
              <span class="text-sm lg:text-base font-medium">
                v{entry.version}
              </span>

              <time datetime={entry.date} class="text-sm text-neutral-400">
                {formatDate(entry.date, lang, {
                  day: "2-digit",
                  month: "2-digit",
                  year: "numeric",
                })}
              </time>
            </div>

            <h2 class="mt-4 text-lg lg:text-xl font-semibold">{entry.title}</h2>

            <ul class="mt-4 space-y-3 text-sm text-neutral-500 dark:text-neutral-400">
              {entry.changes.map((change) => (
                <li class="flex gap-3">
                  <span class="text-neutral-300 dark:text-neutral-700">•</span>
                  <span>{change}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</div>
