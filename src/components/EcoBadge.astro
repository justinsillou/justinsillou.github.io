---
/**
 * Mention d'écoconception affichée dans le footer.
 *
 * Le poids réel transféré est mesuré côté navigateur (Resource Timing),
 * puis converti en estimation de CO₂ avec le facteur du modèle
 * Sustainable Web Design (~0,494 g de CO₂e par Mo transféré).
 *
 * Le lien renvoie vers EcoIndex, qui calcule la note officielle de la
 * page réellement consultée.
 *
 * Le script ne connaît pas la langue : ses libellés lui arrivent par
 * attributs `data-…`, remplis ici avec les chaînes traduites.
 */

import { getLangFromUrl, localeTags, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
  class="flex flex-col items-center gap-1 text-xs text-neutral-400 dark:text-neutral-500"
>
  <p class="flex items-center gap-1.5">
    <svg
      class="w-3.5 h-3.5 shrink-0 text-emerald-500"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M11 20A7 7 0 0 1 4 13c0-4 4-9 7-11 3 2 7 7 7 11a7 7 0 0 1-7 7Z"
      ></path>
      <path d="M11 20v-6"></path>
    </svg>

    <span
      id="eco-badge-text"
      data-template={t("eco.weight")}
      data-unit-kb={t("eco.unitKb")}
      data-unit-mb={t("eco.unitMb")}
      data-locale={localeTags[lang]}
    >
      {t("eco.static")}
    </span>
  </p>

  <div class="flex items-center gap-2">
    <a
      id="eco-badge-link"
      href="https://www.ecoindex.fr/"
      target="_blank"
      rel="noopener noreferrer"
      class="underline underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-100"
    >
      {t("eco.measure")}
    </a>

    <!-- Précision sur ce que la note ne couvre pas. Pas de JavaScript : un
         <details> suffit, et reste utilisable au clavier. -->
    <details class="eco-note relative">
      <summary
        class="flex h-4 w-4 cursor-pointer list-none items-center justify-center rounded-full border border-neutral-300 text-[9px] leading-none transition-colors hover:border-neutral-500 hover:text-neutral-700 dark:border-neutral-700 dark:hover:border-neutral-500 dark:hover:text-neutral-300 [&::-webkit-details-marker]:hidden"
        aria-label={t("eco.noteLabel")}
        title={t("eco.noteLabel")}
      >
        i
      </summary>

      <div
        class="absolute bottom-6 right-0 z-50 w-64 max-w-[calc(100vw-2rem)] rounded-lg border border-neutral-200 bg-white p-3 text-left text-xs leading-relaxed shadow-lg dark:border-neutral-800 dark:bg-neutral-950"
      >
        {t("eco.note")}

        <span class="mt-2 block text-neutral-400 dark:text-neutral-500">
          {t("eco.noteExtra")}
        </span>
      </div>
    </details>
  </div>
</div>

<script>
  window.addEventListener("load", () => {
    const text = document.getElementById("eco-badge-text");
    const link = document.getElementById("eco-badge-link") as
      | HTMLAnchorElement
      | null;

    // EcoIndex analyse l'URL publique : inutile de pointer vers localhost.
    //
    // On lui transmet la page seule, sans query ni fragment : un filtre
    // (`?filtre=Mobile`) ou une ancre ne changent rien à la mesure, et n'ont
    // rien à faire chez un tiers.
    if (link && window.location.hostname !== "localhost") {
      const page = new URL(window.location.href);
      page.search = "";
      page.hash = "";

      link.href = `https://bff.ecoindex.fr/redirect/?url=${encodeURIComponent(
        page.href,
      )}`;
    }

    if (!text) return;

    try {
      const navigation = performance.getEntriesByType("navigation")[0] as
        | PerformanceNavigationTiming
        | undefined;

      const resources = performance.getEntriesByType(
        "resource",
      ) as PerformanceResourceTiming[];

      const bytes =
        (navigation?.transferSize ?? 0) +
        resources.reduce(
          (total, resource) => total + (resource.transferSize ?? 0),
          0,
        );

      if (bytes <= 0) return;

      const locale = text.dataset.locale ?? "fr-FR";
      const template = text.dataset.template ?? "";
      const unitKb = text.dataset.unitKb ?? "Ko";
      const unitMb = text.dataset.unitMb ?? "Mo";

      if (!template) return;

      const kilobytes = bytes / 1024;

      // Facteur Sustainable Web Design : 0,494 g CO₂e par Mo transféré.
      const grams = (bytes / 1_048_576) * 0.494;

      const format = (value: number, digits: number) =>
        value.toLocaleString(locale, {
          minimumFractionDigits: digits,
          maximumFractionDigits: digits,
        });

      const size =
        kilobytes >= 1024
          ? `${format(kilobytes / 1024, 2)} ${unitMb}`
          : `${format(kilobytes, 0)} ${unitKb}`;

      text.textContent = template
        .replace("{size}", size)
        .replace("{grams}", format(grams, 2));
    } catch {
      /* On garde le texte statique par défaut. */
    }
  });

  // Referme l'infobulle au clic à l'extérieur ou sur Échap.
  const note = document.querySelector<HTMLDetailsElement>(".eco-note");

  if (note) {
    document.addEventListener("click", (event) => {
      if (note.open && !note.contains(event.target as Node)) note.open = false;
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") note.open = false;
    });
  }
</script>
