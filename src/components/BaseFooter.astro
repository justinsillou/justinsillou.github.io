---
import { changelog } from "../content/changelog";
//import ReadingSizeToggle from "./ReadingSizeToggle.astro";
//import EcoBadge from "./EcoBadge.astro";

const latest = changelog[0];
---

<footer
  class="shrink-0 max-w-md mx-auto mb-8 flex flex-col items-center gap-4 text-center text-xs text-neutral-400"
>
  <a
    href="/changelog"
    class="hover:text-neutral-900 dark:hover:text-neutral-100 hover:underline"
  >
    Dernière mise à jour : {latest.date} — v{latest.version}
  </a>

  <div class="flex flex-wrap items-center justify-center gap-4">
    {/* <ReadingSizeToggle /> */}
    {/* <EcoBadge /> */}
  </div>
</footer>