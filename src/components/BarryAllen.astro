<div
  id="konami-progress"
  class="fixed bottom-6 left-1/2 z-[90] -translate-x-1/2 opacity-0 translate-y-2 pointer-events-none transition-all duration-300"
>
  <div
    class="px-4 py-2 rounded-full border border-neutral-200/80 dark:border-neutral-800/80 bg-white/80 dark:bg-neutral-950/80 backdrop-blur-xl shadow-lg"
  >
    <div class="flex items-center gap-1.5">
      {
        ["↑", "↑", "↓", "↓", "←", "→", "←", "→", "B", "A"].map((key, index) => (
          <span
            data-konami-key={index}
            class="w-5 h-5 flex items-center justify-center rounded text-[10px] font-mono text-neutral-300 dark:text-neutral-700 transition-all duration-200"
          >
            {key}
          </span>
        ))
      }
    </div>
  </div>
</div>

<!-- Modal Rickroll -->
<div
  id="konami-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4"
>
  <div class="relative w-full max-w-3xl">
    <!-- Bouton qui fuit -->
    <button
      id="konami-close"
      type="button"
      aria-label="Fermer"
      class="fixed z-[110] w-9 h-9 flex items-center justify-center rounded-full border border-white/20 bg-black/40 text-white hover:bg-white/10 transition-all duration-200"
    >
      <svg
        class="w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M6 6l12 12"></path>
        <path d="M18 6l-12 12"></path>
      </svg>
    </button>

    <!-- Vidéo non interactive -->
    <div
      class="relative aspect-video overflow-hidden rounded-xl bg-black shadow-2xl pointer-events-none select-none"
    >
      <iframe
        id="konami-video"
        class="absolute inset-0 w-full h-full pointer-events-none"
        src=""
        title="Easter egg"
        tabindex="-1"
        allow="autoplay; encrypted-media; picture-in-picture"
        allowfullscreen></iframe>
    </div>
  </div>
</div>

<script>
  const konamiCode = [
    "ArrowUp",
    "ArrowUp",
    "ArrowDown",
    "ArrowDown",
    "ArrowLeft",
    "ArrowRight",
    "ArrowLeft",
    "ArrowRight",
    "b",
    "a",
  ];

  const progress = document.getElementById("konami-progress");
  const keys = document.querySelectorAll("[data-konami-key]");

  const modal = document.getElementById("konami-modal");
  const video = document.getElementById("konami-video");
  const closeButton = document.getElementById("konami-close");

  let index = 0;
  let hideTimeout: ReturnType<typeof setTimeout>;

  /**
   * Met à jour l'indicateur de progression
   */
  const updateProgress = () => {
    keys.forEach((key, keyIndex) => {
      const active = keyIndex < index;
      const current = keyIndex === index - 1;

      key.classList.toggle("text-neutral-900", active);
      key.classList.toggle("dark:text-neutral-100", active);

      key.classList.toggle("text-neutral-300", !active);
      key.classList.toggle("dark:text-neutral-700", !active);

      key.classList.toggle("scale-110", current);
    });

    if (index > 0) {
      progress?.classList.remove("opacity-0", "translate-y-2");
      progress?.classList.add("opacity-100", "translate-y-0");

      clearTimeout(hideTimeout);

      hideTimeout = setTimeout(() => {
        if (index === 0) {
          progress?.classList.add("opacity-0", "translate-y-2");
          progress?.classList.remove("opacity-100", "translate-y-0");
        }
      }, 2000);
    }
  };

  /**
   * Réinitialise la progression
   */
  const resetProgress = () => {
    index = 0;

    keys.forEach((key) => {
      key.classList.remove(
        "text-neutral-900",
        "dark:text-neutral-100",
        "scale-110",
      );

      key.classList.add("text-neutral-300", "dark:text-neutral-700");
    });

    clearTimeout(hideTimeout);

    progress?.classList.add("opacity-0", "translate-y-2");
    progress?.classList.remove("opacity-100", "translate-y-0");
  };

  /**
   * Déplace le bouton de fermeture
   */
  const moveCloseButton = () => {
    if (!closeButton) return;

    const padding = 20;

    const buttonWidth = closeButton.offsetWidth;
    const buttonHeight = closeButton.offsetHeight;

    const maxX = window.innerWidth - buttonWidth - padding;
    const maxY = window.innerHeight - buttonHeight - padding;

    const x = padding + Math.random() * Math.max(0, maxX - padding);

    const y = padding + Math.random() * Math.max(0, maxY - padding);

    closeButton.style.position = "fixed";
    closeButton.style.left = `${x}px`;
    closeButton.style.top = `${y}px`;
    closeButton.style.right = "auto";
  };

  /**
   * Ouvre le Rickroll
   */
  const openKonami = () => {
    if (!modal || !video) return;

    video.setAttribute(
      "src",
      "https://www.youtube.com/embed/dQw4w9WgXcQ?autoplay=1&rel=0",
    );

    closeButton?.removeAttribute("style");

    closeButton?.style.setProperty("top", "20px");
    closeButton?.style.setProperty("right", "20px");

    modal.classList.remove("hidden");
    modal.classList.add("flex");

    resetProgress();
  };
  /**
   * Ferme le Rickroll
   */
  const closeKonami = () => {
    if (!modal || !video) return;

    modal.classList.add("hidden");
    modal.classList.remove("flex");

    video.setAttribute("src", "");

    // Remet le bouton à sa position originale
    closeButton?.removeAttribute("style");

    resetProgress();
  };

  /**
   * Détection du Konami Code
   */
  document.addEventListener("keydown", (event) => {
    const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;

    if (key === konamiCode[index]) {
      index++;

      updateProgress();

      if (index === konamiCode.length) {
        openKonami();
      }

      return;
    }

    resetProgress();

    // Permet de recommencer directement avec la première touche
    if (key === konamiCode[0]) {
      index = 1;
      updateProgress();
    }
  });

  /**
   * Le bouton fuit lorsqu'on l'approche
   */
  closeButton?.addEventListener("mouseenter", moveCloseButton);

  /**
   * Si on arrive malgré tout à cliquer dessus,
   * il fuit à nouveau.
   */
  closeButton?.addEventListener("click", (event) => {
    event.preventDefault();
    event.stopPropagation();

    moveCloseButton();
  });

  /**
   * Escape = seul moyen de fermer
   */
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeKonami();
    }
  });
</script>
