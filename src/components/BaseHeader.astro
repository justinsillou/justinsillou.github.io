---
import FlagIcon from "./FlagIcon.astro";

import {
  getLangFromUrl,
  languages,
  localizePath,
  stripLang,
  useTranslations,
  type Lang,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pathname = Astro.url.pathname;
const bare = stripLang(pathname);

// Comparaisons sans slash final : `/404` et `/404/` désignent la même page.
const route = bare.replace(/\/$/, "") || "/";

const showHomeButton = route !== "/" && route !== "/404";

const menuItems = [
  { label: t("nav.now"), href: localizePath(lang, "/now") },
  { label: t("nav.projects"), href: localizePath(lang, "/projets") },
  { label: t("nav.blog"), href: localizePath(lang, "/blog") },
  { label: t("nav.cv"), href: localizePath(lang, "/cv") },
];

// Sélecteur de langue : même page, autre langue.
// La 404 fait exception : elle n'existe qu'une fois, on renvoie à l'accueil.
const otherLang: Lang = lang === "fr" ? "en" : "fr";

const otherLangHref = localizePath(otherLang, route === "/404" ? "/" : bare);
---

<header>
  <!-- Accueil -->
  {
    showHomeButton && (
      <a
        href={localizePath(lang, "/")}
        aria-label={t("nav.homeAria")}
        title={t("nav.homeTitle")}
        class="fixed top-4 left-4 z-50 w-9 h-9 flex items-center justify-center rounded-full border border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-neutral-950/80 backdrop-blur text-neutral-500 dark:text-neutral-400 hover:border-neutral-400 dark:hover:border-neutral-600 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        <svg
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m3 10 9-7 9 7v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          <path d="M9 21v-8h6v8" />
        </svg>
      </a>
    )
  }

  <!-- Zone droite -->
  <div class="fixed top-4 right-4 z-50 flex items-center gap-2">
    <!-- Liens de navigation : desktop uniquement -->
    <nav
      aria-label={t("nav.main")}
      class="hidden md:flex items-center gap-1 mr-1 px-1.5 py-1.5 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-neutral-950/80 backdrop-blur"
    >
      {
        menuItems.map((item) => (
          <a
            href={item.href}
            class="px-3 py-1.5 rounded-full text-sm font-medium text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-900 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Menu bulle : tablette / mobile uniquement -->
    <button
      id="menu-toggle"
      type="button"
      aria-label={t("nav.openMenu")}
      aria-expanded="false"
      aria-controls="site-menu"
      data-label-open={t("nav.openMenu")}
      data-label-close={t("nav.closeMenu")}
      class="md:hidden w-9 h-9 flex items-center justify-center rounded-full border border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-neutral-950/80 backdrop-blur text-neutral-500 dark:text-neutral-400 hover:border-neutral-400 dark:hover:border-neutral-600 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
    >
      <!-- Menu -->
      <svg
        id="menu-icon"
        class="w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16"></path>
        <path d="M4 12h16"></path>
        <path d="M4 17h16"></path>
      </svg>

      <!-- Fermer -->
      <svg
        id="close-icon"
        class="hidden w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12"></path>
        <path d="M18 6l-12 12"></path>
      </svg>
    </button>

    <!-- Langue -->
    <a
      href={otherLangHref}
      hreflang={otherLang}
      aria-label={t("nav.languageTo")}
      title={languages[otherLang]}
      class="w-9 h-9 flex items-center justify-center rounded-full border border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-neutral-950/80 backdrop-blur text-neutral-500 dark:text-neutral-400 hover:border-neutral-400 dark:hover:border-neutral-600 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
    >
      <FlagIcon lang={otherLang} />

      <span class="sr-only">{languages[otherLang]}</span>
    </a>

    <!-- Recherche -->
    <button
      id="search-toggle"
      type="button"
      aria-label={t("nav.search")}
      title={t("nav.searchTitle")}
      class="w-9 h-9 flex items-center justify-center rounded-full border border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-neutral-950/80 backdrop-blur text-neutral-500 dark:text-neutral-400 hover:border-neutral-400 dark:hover:border-neutral-600 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
    >
      <svg
        class="w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
    </button>

    <!-- Light / Dark -->
    <button
      id="theme-toggle"
      type="button"
      aria-label={t("nav.theme")}
      class="w-9 h-9 flex items-center justify-center rounded-full border border-neutral-200 dark:border-neutral-800 bg-white/80 dark:bg-neutral-950/80 backdrop-blur text-neutral-500 dark:text-neutral-400 hover:border-neutral-400 dark:hover:border-neutral-600 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
    >
      <!-- Lune -->
      <svg
        class="w-4 h-4 dark:hidden"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>

      <!-- Soleil -->
      <svg
        class="w-4 h-4 hidden dark:block"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="5"></circle>
        <path
          d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Menu flottant en bulle : tablette / mobile uniquement -->
  <nav
    id="site-menu"
    aria-label={t("nav.mainMobile")}
    aria-hidden="true"
    class="md:hidden fixed top-16 right-4 z-40 w-48 origin-top-right opacity-0 scale-95 pointer-events-none transition-all duration-150"
  >
    <div
      class="rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white/90 dark:bg-neutral-950/90 backdrop-blur-xl shadow-lg p-2"
    >
      <div class="space-y-1">
        {
          menuItems.map((item) => (
            <a
              href={item.href}
              class="block px-3 py-2 rounded-xl text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-900 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</header>

<script>
  // La palette de recherche vit dans une île React : on la réveille par un
  // évènement plutôt que de dupliquer son état ici.
  document.getElementById("search-toggle")?.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("open-search"));
  });

  const menuToggle = document.getElementById("menu-toggle");
  const siteMenu = document.getElementById("site-menu");
  const menuIcon = document.getElementById("menu-icon");
  const closeIcon = document.getElementById("close-icon");

  // Les libellés viennent du serveur : ce script n'a pas à connaître la langue.
  const labelOpen = menuToggle?.dataset.labelOpen ?? "";
  const labelClose = menuToggle?.dataset.labelClose ?? "";

  let menuOpen = false;

  const setMenuState = (open: boolean) => {
    menuOpen = open;

    menuToggle?.setAttribute("aria-expanded", String(open));
    menuToggle?.setAttribute("aria-label", open ? labelClose : labelOpen);

    siteMenu?.setAttribute("aria-hidden", String(!open));

    siteMenu?.classList.toggle("opacity-0", !open);
    siteMenu?.classList.toggle("scale-95", !open);
    siteMenu?.classList.toggle("pointer-events-none", !open);

    siteMenu?.classList.toggle("opacity-100", open);
    siteMenu?.classList.toggle("scale-100", open);

    menuIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  };

  menuToggle?.addEventListener("click", () => {
    setMenuState(!menuOpen);
  });

  document.addEventListener("click", (event) => {
    if (!menuOpen) return;

    const target = event.target as Node;

    if (!siteMenu?.contains(target) && !menuToggle?.contains(target)) {
      setMenuState(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      setMenuState(false);
    }
  });

  // Sur desktop, si la fenêtre est agrandie pendant que le menu mobile est ouvert,
  // on referme proprement pour éviter un état incohérent.
  const mq = window.matchMedia("(min-width: 768px)");
  mq.addEventListener("change", (e) => {
    if (e.matches && menuOpen) {
      setMenuState(false);
    }
  });

  siteMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      setMenuState(false);
    });
  });
</script>
