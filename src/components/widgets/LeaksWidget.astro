---
import Widget from "./Widget.astro";
import {
  getLatestLeaks,
  LEAKS_SOURCE_NAME,
  LEAKS_SOURCE_URL,
} from "../../data/leaks";

import {
  formatDate,
  getLangFromUrl,
  localizePath,
  useTranslations,
} from "../../i18n/utils";

/**
 * Raccourci « dernières fuites de données recensées en France ».
 *
 * Utilisable partout :
 *
 *   <LeaksWidget />                       plein format
 *   <LeaksWidget limit={4} compact />     aperçu, sans les volumes
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type Props = {
  limit?: number;
  /** Version resserrée : une ligne par fuite, pas de volume. */
  compact?: boolean;
  title?: string;
  /** Masquer le crédit de la source (si déjà cité à côté). */
  hideNote?: boolean;
  class?: string;
};

const {
  limit = 8,
  compact = false,
  title = t("widget.leaks.title"),
  hideNote = false,
  class: className = "",
} = Astro.props;

const { leaks, stale } = await getLatestLeaks(limit);

// Quand le flux est injoignable, les données viennent de l'instantané
// versionné : afficher la date du build laisserait croire à un relevé du jour.
// On annonce alors la date de la fuite la plus récente réellement connue.
const meta = stale
  ? t("widget.leaks.metaStale", {
      date: formatDate(leaks[0]?.date ?? new Date(), lang),
    })
  : t("widget.leaks.meta", { date: formatDate(new Date(), lang) });
---

{
  leaks.length > 0 && (
    <Widget
      title={title}
      meta={meta}
      href={localizePath(lang, "/blog/fuites-de-donnees-france")}
      linkLabel={t("widget.leaks.link")}
      class={className}
    >
      <ul class="divide-y divide-neutral-100 dark:divide-neutral-900">
        {leaks.map((leak) => (
          <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1 py-2.5 first:pt-0 last:pb-0">
            <time
              datetime={leak.date}
              class="cv-mono w-16 shrink-0 text-xs text-neutral-400 dark:text-neutral-500"
            >
              {formatDate(leak.date, lang, {
                day: "2-digit",
                month: "short",
              })}
            </time>

            <span class="min-w-0 flex-1 text-sm text-neutral-900 dark:text-neutral-100">
              {leak.organization}

              {leak.status === "claimed" && (
                <span
                  class="cv-mono ml-2 text-[10px] text-amber-600 dark:text-amber-500"
                  title={t("widget.leaks.claimedTitle")}
                >
                  {t("widget.leaks.claimed")}
                </span>
              )}

              {leak.sensitive && !compact && (
                <span
                  class="cv-mono ml-2 text-[10px] text-neutral-400 dark:text-neutral-500"
                  title={t("widget.leaks.sensitiveTitle")}
                >
                  {t("widget.leaks.sensitive")}
                </span>
              )}
            </span>

            {!compact && leak.volume && (
              <span class="cv-mono shrink-0 text-xs text-neutral-500 dark:text-neutral-400">
                {leak.volume}
              </span>
            )}
          </li>
        ))}
      </ul>

      {!hideNote && (
        <p slot="note">
          {t("widget.leaks.sourceBefore")}
          <a
            href={LEAKS_SOURCE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-100"
          >
            {LEAKS_SOURCE_NAME}
          </a>
          {t("widget.leaks.sourceAfter")}
        </p>
      )}
    </Widget>
  )
}
