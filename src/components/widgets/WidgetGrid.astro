---
/**
 * Grille de raccourcis.
 *
 * Sert à empiler plusieurs <Widget> côte à côte sans réfléchir à la mise en
 * page : une colonne sur mobile, `columns` colonnes à partir de `sm`.
 *
 *   <WidgetGrid columns={2}>
 *     <LeaksWidget limit={4} compact />
 *     <AutreWidget />
 *   </WidgetGrid>
 */

type Props = {
  columns?: 1 | 2 | 3;
  class?: string;
};

const { columns = 1, class: className = "" } = Astro.props;

const COLUMNS: Record<number, string> = {
  1: "grid-cols-1",
  2: "grid-cols-1 sm:grid-cols-2",
  3: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
};
---

<div class:list={["grid gap-6", COLUMNS[columns], className]}>
  <slot />
</div>
