---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
  a.localeCompare(b, "fr"),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("fr-FR", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });

const readingTime = (body: string) =>
  Math.max(1, Math.round(body.trim().split(/\s+/).length / 200));
---

<BaseLayout title="Blog — Justin Sillou" fullWidth>
  <div
    class="w-full max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-16 xl:px-20 py-14 sm:py-20 lg:py-28"
  >
    <header class="mb-14 sm:mb-16 lg:mb-24 max-w-3xl">
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl text-neutral-900 dark:text-neutral-100"
      >
        Blog
      </h1>

      <p
        class="mt-3 sm:mt-4 text-base sm:text-lg text-neutral-500 dark:text-neutral-400"
      >
        Des notes sur ce que je lis, ce que je casse et ce que je répare. Peu
        d'articles, mais tenus à jour.
      </p>

      <p class="mt-5">
        <a
          href="/rss.xml"
          class="cv-mono text-xs text-neutral-400 underline underline-offset-4 hover:text-neutral-900 dark:text-neutral-500 dark:hover:text-neutral-100"
        >
          Suivre par RSS
        </a>
      </p>
    </header>

    <div
      class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] gap-12 lg:gap-24"
    >
      <!-- Colonne principale -->
      <div class="min-w-0 lg:order-1 order-2">
        {
          posts.length === 0 ? (
            <p class="text-neutral-500 dark:text-neutral-400">
              Pas encore d'article publié.
            </p>
          ) : (
            <ul class="divide-y divide-neutral-200 dark:divide-neutral-800">
              {posts.map((post) => (
                <li class="post-item" data-tags={post.data.tags.join("|")}>
                  <a href={`/blog/${post.id}`} class="group block py-7 sm:py-8">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 cv-mono text-xs text-neutral-400 dark:text-neutral-500">
                      <time datetime={post.data.pubDate.toISOString()}>
                        {formatDate(post.data.pubDate)}
                      </time>

                      <span aria-hidden="true">·</span>

                      <span>{readingTime(post.body ?? "")} min</span>

                      {post.data.evergreen && (
                        <>
                          <span aria-hidden="true">·</span>

                          <span class="text-emerald-600 dark:text-emerald-400">
                            suivi
                          </span>
                        </>
                      )}
                    </div>

                    <h2 class="mt-3 max-w-3xl text-lg sm:text-xl lg:text-2xl font-semibold text-neutral-900 underline-offset-4 group-hover:underline dark:text-neutral-100">
                      {post.data.title}
                    </h2>

                    <p class="mt-3 max-w-3xl text-sm sm:text-base leading-relaxed text-neutral-500 dark:text-neutral-400">
                      {post.data.description}
                    </p>
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        <p
          id="posts-empty"
          class="hidden py-10 text-sm text-neutral-400 dark:text-neutral-500"
        >
          Aucun article sur ce thème.
        </p>
      </div>

      <!-- Filtres -->
      {
        tags.length > 0 && (
          <aside class="lg:order-2 order-1 lg:sticky lg:top-24 lg:self-start">
            <h2 class="cv-mono text-xs sm:text-sm uppercase text-neutral-400 dark:text-neutral-500 mb-5">
              Thèmes
            </h2>

            <div
              class="flex flex-wrap items-center gap-2"
              role="group"
              aria-label="Filtrer les articles par thème"
            >
              <button
                type="button"
                data-filter="all"
                aria-pressed="true"
                class="filter-btn cv-mono text-xs px-3 py-1.5 rounded-full border border-neutral-200 dark:border-neutral-800 transition-colors"
              >
                tous
              </button>

              {tags.map((tag) => (
                <button
                  type="button"
                  data-filter={tag}
                  aria-pressed="false"
                  class="filter-btn cv-mono text-xs px-3 py-1.5 rounded-full border border-neutral-200 dark:border-neutral-800 transition-colors"
                >
                  {tag.toLowerCase()}
                </button>
              ))}
            </div>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const items = document.querySelectorAll<HTMLLIElement>(".post-item");
  const empty = document.getElementById("posts-empty");

  const ACTIVE = [
    "bg-neutral-900",
    "dark:bg-neutral-100",
    "text-white",
    "dark:text-neutral-900",
    "border-neutral-900",
    "dark:border-neutral-100",
  ];

  const applyFilter = (filter: string) => {
    if (items.length === 0) return;

    let visible = 0;

    items.forEach((item) => {
      const tags = (item.dataset.tags ?? "").split("|");
      const match = filter === "all" || tags.includes(filter);

      item.classList.toggle("hidden", !match);

      if (match) visible += 1;
    });

    buttons.forEach((button) => {
      const isActive = button.dataset.filter === filter;
      button.setAttribute("aria-pressed", String(isActive));
      ACTIVE.forEach((cls) => button.classList.toggle(cls, isActive));
    });

    empty?.classList.toggle("hidden", visible > 0);
  };

  buttons.forEach((button) => {
    button.addEventListener("click", () =>
      applyFilter(button.dataset.filter ?? "all"),
    );
  });

  applyFilter("all");
</script>
