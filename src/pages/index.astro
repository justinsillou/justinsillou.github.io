    <h1 class="text-3xl font-bold">Justin Sillou</h1>
    <p class="mt-1 text-neutral-500 dark:text-neutral-400">Développeur fullstack</p>
    <p class="mt-6 text-sm text-neutral-500 dark:text-neutral-400">
      Nouveau site en préparation, à très bientôt.
    </p>
    <nav class="mt-8 flex gap-4 justify-center" aria-label="Liens">
      <a href="https://github.com/justinsillou" target="_blank" rel="noopener noreferrer" class="px-4 py-2 border rounded-lg hover:opacity-70">GitHub</a>
      <a href="https://www.linkedin.com/in/justinsillou/" target="_blank" rel="noopener noreferrer" class="px-4 py-2 border rounded-lg hover:opacity-70">LinkedIn</a>
    </nav>
  </div>
</BaseLayout>