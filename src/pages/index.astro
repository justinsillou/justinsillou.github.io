---
import BaseLayout from "../layouts/BaseLayout.astro";
import WidgetGrid from "../components/widgets/WidgetGrid.astro";
import LeaksWidget from "../components/widgets/LeaksWidget.astro";
import HighlightsWidget from "../components/widgets/HighlightsWidget.astro";

const links = [
  { label: "Now", href: "/now", hint: "ce que je fais en ce moment" },
  { label: "Projets", href: "/projets", hint: "perso et universitaires" },
  { label: "Blog", href: "/blog", hint: "notes et veille" },
  { label: "CV", href: "/cv", hint: "parcours détaillé" },
];

const externalLinks = [
  { label: "GitHub", href: "https://github.com/justinsillou" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/justinsillou/" },
];
---

<BaseLayout fullWidth>
  <div
    class="w-full max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-16 xl:px-20 py-14 sm:py-20 lg:py-28"
  >
    <div
      class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] gap-12 lg:gap-24"
    >
      <!-- Colonne principale -->
      <div class="min-w-0">
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl text-neutral-900 dark:text-neutral-100"
        >
          Justin Sillou
        </h1>

        <p
          class="mt-3 sm:mt-4 text-base sm:text-lg text-neutral-500 dark:text-neutral-400"
        >
          Développeur back-end — Lille
        </p>

        <p
          class="mt-6 max-w-2xl text-sm sm:text-base leading-relaxed text-neutral-500 dark:text-neutral-400"
        >
          J'écris surtout du back-end : API, outils internes, un peu d'infra. Ce
          site est volontairement statique et léger — quelques pages, pas de
          tracker.
        </p>

        <!-- Sections : deux colonnes plutôt qu'une pile -->
        <nav
          class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-x-8 border-t border-neutral-200 dark:border-neutral-800"
          aria-label="Sections du site"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                class="group border-b border-neutral-200 py-5 dark:border-neutral-800"
              >
                <span class="text-lg sm:text-xl text-neutral-900 underline-offset-4 group-hover:underline dark:text-neutral-100">
                  {link.label}
                </span>

                <span class="mt-1 block cv-mono text-xs text-neutral-400 dark:text-neutral-500">
                  {link.hint}
                </span>
              </a>
            ))
          }
        </nav>

        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-2">
          {
            externalLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="cv-mono text-xs text-neutral-500 underline underline-offset-4 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
              >
                {link.label} ↗
              </a>
            ))
          }

          <span
            class="hidden cv-mono text-xs text-neutral-300 md:inline dark:text-neutral-700"
          >
            Ctrl + K pour chercher dans le site
          </span>
        </div>
      </div>

      <!-- Colonne des raccourcis : ajouter d'autres <Widget> à la volée -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <WidgetGrid>
          <HighlightsWidget />
          <LeaksWidget limit={5} compact hideNote />
        </WidgetGrid>
      </aside>
    </div>
  </div>
</BaseLayout>
