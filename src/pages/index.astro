---
import '../styles/global.css';

// Date mise à jour manuellement pour éviter qu'elle change à chaque build
const lastUpdate = '14/07/2026';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Justin Sillou</title>
    <meta name="description" content="Site en cours de refonte. Me retrouver sur GitHub et LinkedIn en attendant." />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <div class="page">
      <main class="content">
        <h1>Justin Sillou</h1>
        <p class="role">Développeur fullstack</p>

        <p class="note">Nouveau site en préparation, à très bientôt.</p>

        <nav class="links" aria-label="Liens">
          <a href="https://github.com/justinsillou" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/justinsillou/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </nav>
      </main>

      <footer class="footer">
        <p>Dernière mise à jour : {lastUpdate}</p>
      </footer>
    </div>
  </body>
</html>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    max-width: 560px;
    margin: 0 auto;
    padding: 32px 24px;
  }

  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 0;
  }

  h1 {
    font-size: clamp(1.9rem, 5vw, 2.4rem);
    font-weight: 500;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .role {
    font-size: 1rem;
    color: var(--muted);
    margin: 4px 0 20px;
  }

  .note {
    max-width: 42ch;
    line-height: 1.65;
    margin: 0 0 28px;
  }

  .links {
    display: flex;
    gap: 24px;
  }

  .links a {
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
</style>