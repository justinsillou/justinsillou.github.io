---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  nowSections,
  nowUpdatedAt,
  nowLocation,
  nowIntro,
} from "../data/now";

const formattedDate = new Date(nowUpdatedAt).toLocaleDateString("fr-FR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title="Now — Justin Sillou" fullWidth>
  <div
    class="w-full max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-16 xl:px-20 py-14 sm:py-20 lg:py-28"
  >
    <header class="mb-14 sm:mb-16 lg:mb-24 max-w-3xl">
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl text-neutral-900 dark:text-neutral-100"
      >
        Now
      </h1>

      <p
        class="mt-3 sm:mt-4 text-base sm:text-lg leading-relaxed text-neutral-500 dark:text-neutral-400"
      >
        {nowIntro}
      </p>
    </header>

    <div
      class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] gap-12 lg:gap-24"
    >
      <!-- Colonne principale -->
      <div class="min-w-0 space-y-14 lg:space-y-16">
        {
          nowSections.map((section) => (
            <section>
              <h2 class="cv-mono text-xs sm:text-sm uppercase text-neutral-400 dark:text-neutral-500 border-b border-neutral-200 dark:border-neutral-800 pb-3 mb-6">
                {section.title}
              </h2>

              {section.intro && (
                <p class="-mt-3 mb-5 text-sm text-neutral-400 dark:text-neutral-500">
                  {section.intro}
                </p>
              )}

              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-6">
                {section.items.map((item) => (
                  <li>
                    {item.href ? (
                      <a
                        href={item.href}
                        class="text-base sm:text-lg text-neutral-900 underline underline-offset-4 hover:opacity-70 dark:text-neutral-100"
                      >
                        {item.label}
                      </a>
                    ) : (
                      <span class="text-base sm:text-lg text-neutral-900 dark:text-neutral-100">
                        {item.label}
                      </span>
                    )}

                    {item.detail && (
                      <p class="mt-1 max-w-2xl text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
                        {item.detail}
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <!-- Contexte -->
      <aside class="lg:sticky lg:top-24 lg:self-start space-y-8">
        <div>
          <h2
            class="cv-mono text-xs sm:text-sm uppercase text-neutral-400 dark:text-neutral-500 mb-3"
          >
            Où
          </h2>

          <p class="text-sm text-neutral-600 dark:text-neutral-300">
            {nowLocation}
          </p>
        </div>

        <div>
          <h2
            class="cv-mono text-xs sm:text-sm uppercase text-neutral-400 dark:text-neutral-500 mb-3"
          >
            Mise à jour
          </h2>

          <p class="text-sm text-neutral-600 dark:text-neutral-300">
            {formattedDate}
            <span
              id="now-freshness"
              data-date={nowUpdatedAt}
              class="text-neutral-400 dark:text-neutral-500"></span>
          </p>
        </div>

        <p class="text-xs leading-relaxed text-neutral-400 dark:text-neutral-500">
          Page inspirée du <a
            href="https://nownownow.com/about"
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-100"
            >/now movement</a
          > de Derek Sivers.
        </p>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  // Indicateur de fraîcheur : « il y a 12 jours ».
  const el = document.getElementById("now-freshness");
  const raw = el?.dataset.date;

  if (el && raw) {
    const days = Math.floor(
      (Date.now() - new Date(raw).getTime()) / 86_400_000,
    );

    const label =
      days <= 0
        ? "aujourd'hui"
        : days === 1
          ? "hier"
          : days < 31
            ? `il y a ${days} jours`
            : days < 365
              ? `il y a ${Math.floor(days / 30)} mois`
              : `il y a ${Math.floor(days / 365)} an${days >= 730 ? "s" : ""}`;

    el.textContent = ` (${label})`;
  }
</script>
