---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChangelogTimeline from "../../components/ChangelogTimeline.astro";
import RoadmapList from "../../components/RoadmapList.astro";

import { localePaths, useTranslations, type Lang } from "../../i18n/utils";

export const getStaticPaths = () => localePaths();

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout title={`${t("changelog.title")} — ${t("site.name")}`} fullWidth>
  <div
    class="w-full max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-16 xl:px-20 py-14 sm:py-20 lg:py-28"
  >
    <h1
      class="text-4xl sm:text-5xl lg:text-6xl text-neutral-900 dark:text-neutral-100"
    >
      {t("changelog.title")}
    </h1>

    <div
      class="mt-14 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] gap-12 lg:gap-20"
    >
      <!-- Journal des versions -->
      <div class="min-w-0 lg:order-1 order-2">
        <ChangelogTimeline />
      </div>

      <!--
        À venir : collant, pour rester en regard de la timeline pendant tout le
        défilement. Le filet de séparation suit la mise en page — à gauche en
        deux colonnes, en dessous quand la liste passe au-dessus du journal,
        comme les filtres des pages Projets et Blog.
      -->
      <aside
        class="order-1 border-b border-neutral-200 pb-10 lg:order-2 lg:sticky lg:top-24 lg:self-start lg:border-b-0 lg:border-l lg:pb-0 lg:pl-10 dark:border-neutral-800"
      >
        <RoadmapList />
      </aside>
    </div>
  </div>
</BaseLayout>
