---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getNow, nowUpdatedAt } from "../../data/now";

import {
  formatDate,
  localePaths,
  localizePath,
  useTranslations,
  type Lang,
} from "../../i18n/utils";

export const getStaticPaths = () => localePaths();

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const { intro, location, sections } = getNow(lang);

const formattedDate = formatDate(nowUpdatedAt, lang);
---

<BaseLayout title={`${t("now.title")} — ${t("site.name")}`} fullWidth>
  <div
    class="w-full max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-16 xl:px-20 py-14 sm:py-20 lg:py-28"
  >
    <header class="mb-14 sm:mb-16 lg:mb-24 max-w-3xl">
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl text-neutral-900 dark:text-neutral-100"
      >
        {t("now.title")}
      </h1>

      <p
        class="mt-3 sm:mt-4 text-base sm:text-lg leading-relaxed text-neutral-500 dark:text-neutral-400"
      >
        {intro}
      </p>
    </header>

    <div
      class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] gap-12 lg:gap-24"
    >
      <!-- Colonne principale -->
      <div class="min-w-0 space-y-14 lg:space-y-16">
        {
          sections.map((section) => (
            <section>
              <h2 class="cv-mono text-xs sm:text-sm uppercase text-neutral-400 dark:text-neutral-500 border-b border-neutral-200 dark:border-neutral-800 pb-3 mb-6">
                {section.title}
              </h2>

              {section.intro && (
                <p class="-mt-3 mb-5 text-sm text-neutral-400 dark:text-neutral-500">
                  {section.intro}
                </p>
              )}

              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-6">
                {section.items.map((item) => (
                  <li>
                    <div class="flex flex-wrap items-baseline gap-x-2">
                      {item.href ? (
                        <a
                          href={localizePath(lang, item.href)}
                          class="text-base sm:text-lg text-neutral-900 underline underline-offset-4 hover:opacity-70 dark:text-neutral-100"
                        >
                          {item.label}
                        </a>
                      ) : (
                        <span class="text-base sm:text-lg text-neutral-900 dark:text-neutral-100">
                          {item.label}
                        </span>
                      )}

                      {item.author && (
                        <span class="text-sm italic text-neutral-400 dark:text-neutral-500">
                          {item.author}
                        </span>
                      )}
                    </div>

                    {item.detail && (
                      <p class="mt-1 max-w-2xl text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
                        {item.detail}
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <!-- Contexte -->
      <aside class="lg:sticky lg:top-24 lg:self-start space-y-8">
        <div>
          <h2
            class="cv-mono text-xs sm:text-sm uppercase text-neutral-400 dark:text-neutral-500 mb-3"
          >
            {t("now.where")}
          </h2>

          <p class="text-sm text-neutral-600 dark:text-neutral-300">
            {location}
          </p>
        </div>

        <div>
          <h2
            class="cv-mono text-xs sm:text-sm uppercase text-neutral-400 dark:text-neutral-500 mb-3"
          >
            {t("now.updated")}
          </h2>

          <p class="text-sm text-neutral-600 dark:text-neutral-300">
            {formattedDate}
            <span
              id="now-freshness"
              data-date={nowUpdatedAt}
              data-today={t("now.freshness.today")}
              data-yesterday={t("now.freshness.yesterday")}
              data-days={t("now.freshness.days")}
              data-months={t("now.freshness.months")}
              data-years={t("now.freshness.years")}
              class="text-neutral-400 dark:text-neutral-500"></span>
          </p>
        </div>

        <p class="text-xs leading-relaxed text-neutral-400 dark:text-neutral-500">
          {t("now.inspiredBefore")}<a
            href="https://nownownow.com/about"
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-100"
            >{t("now.inspiredLink")}</a
          >{t("now.inspiredAfter")}
        </p>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  // Indicateur de fraîcheur : « il y a 12 jours ».
  // Les formats viennent du serveur pour rester dans la langue de la page.
  const el = document.getElementById("now-freshness");
  const raw = el?.dataset.date;

  if (el && raw) {
    const days = Math.floor((Date.now() - new Date(raw).getTime()) / 86_400_000);

    const fill = (template: string | undefined, count: number) =>
      (template ?? "").replace("{count}", String(count));

    const label =
      days <= 0
        ? (el.dataset.today ?? "")
        : days === 1
          ? (el.dataset.yesterday ?? "")
          : days < 31
            ? fill(el.dataset.days, days)
            : days < 365
              ? fill(el.dataset.months, Math.floor(days / 30))
              : fill(el.dataset.years, Math.floor(days / 365));

    if (label) el.textContent = ` (${label})`;
  }
</script>
