---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import LeaksWidget from "../../../components/widgets/LeaksWidget.astro";
import ShareButton from "../../../components/ShareButton.astro";

import { getPosts, withNeighbours, type Post } from "../../../lib/blog";

import {
  defaultLang,
  formatDate,
  localeList,
  localeTags,
  localizePath,
  useTranslations,
  type Lang,
  type UIKey,
} from "../../../i18n/utils";

export const getStaticPaths: GetStaticPaths = async () => {
  // Un gabarit, deux langues : chaque locale fournit sa propre liste, avec
  // repli sur le français quand la traduction manque.
  const perLocale = await Promise.all(
    localeList.map(async (lang) => ({
      lang,
      posts: withNeighbours(await getPosts(lang)),
    })),
  );

  return perLocale.flatMap(({ lang, posts }) =>
    posts.map(({ post, older, newer }) => ({
      params: {
        locale: lang === defaultLang ? undefined : lang,
        slug: post.slug,
      },
      props: { lang, post, older, newer },
    })),
  );
};

type Props = {
  lang: Lang;
  post: Post;
  older?: Post;
  newer?: Post;
};

const { lang, post: current, older, newer } = Astro.props as Props;
const t = useTranslations(lang);

const post = current.entry;

const { Content, headings } = await render(post);

const readingTime = Math.max(
  1,
  Math.round((post.body ?? "").trim().split(/\s+/).length / 200),
);

// Seuls les h2 alimentent le sommaire : suffisant, et ça reste lisible.
const toc = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout
  title={`${post.data.title} — ${t("site.name")}`}
  description={post.data.description}
  fullWidth
>
  <!-- Progression de lecture : animation pilotée par le scroll, sans JS. -->
  <div class="reading-progress" aria-hidden="true"></div>

  <div
    class="w-full max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-16 xl:px-20 py-14 sm:py-20 lg:py-28"
  >
    <header class="mb-12 sm:mb-14 lg:mb-20 max-w-4xl">
      <a
        href={localizePath(lang, "/blog")}
        class="cv-mono text-xs text-neutral-400 hover:text-neutral-900 dark:text-neutral-500 dark:hover:text-neutral-100"
      >
        {t("post.back")}
      </a>

      <h1
        class="mt-8 text-3xl sm:text-4xl lg:text-5xl leading-tight text-neutral-900 dark:text-neutral-100"
      >
        {post.data.title}
      </h1>

      <p
        class="mt-4 sm:mt-5 max-w-3xl text-base sm:text-lg leading-relaxed text-neutral-500 dark:text-neutral-400"
      >
        {post.data.description}
      </p>

      <div
        class="mt-6 flex max-w-3xl flex-wrap items-center gap-x-3 gap-y-2 cv-mono text-xs text-neutral-400 dark:text-neutral-500"
      >
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate, lang)}
        </time>

        <span aria-hidden="true">·</span>

        <span>{t("post.readingTime", { count: readingTime })}</span>

        {
          post.data.tags.map((tag) => (
            <span class="text-neutral-300 dark:text-neutral-700">
              #{tag.toLowerCase()}
            </span>
          ))
        }

        <ShareButton title={post.data.title} class="ml-auto" />
      </div>

      {
        post.data.updatedDate && (
          <p class="mt-3 cv-mono text-xs text-emerald-600 dark:text-emerald-400">
            {t("post.updatedOn", {
              date: formatDate(post.data.updatedDate, lang),
            })}
          </p>
        )
      }
    </header>

    <div
      class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] gap-12 lg:gap-24"
    >
      <!-- Article -->
      <div class="min-w-0 max-w-3xl lg:order-1 order-2">
        {
          current.fallback && (
            <p class="mb-8 rounded-lg border border-neutral-200 px-4 py-3 text-sm text-neutral-500 dark:border-neutral-800 dark:text-neutral-400">
              {t("post.notTranslated")}
            </p>
          )
        }

        <article class="prose-simple" lang={localeTags[current.lang]}>
          <Content />
        </article>

        {post.data.widget === "leaks" && <LeaksWidget class="mt-14" />}

        {
          post.data.ai && (
            <p class="mt-10 cv-mono text-xs text-neutral-400 dark:text-neutral-500">
              {t(`post.ai.${post.data.ai}` as UIKey)}
            </p>
          )
        }

        <!-- Article précédent / suivant -->
        {
          (older || newer) && (
            <nav
              aria-label={t("post.otherPosts")}
              class="mt-14 grid grid-cols-1 gap-6 border-t border-neutral-200 pt-8 sm:grid-cols-2 dark:border-neutral-800"
            >
              {newer ? (
                <a
                  href={localizePath(lang, `/blog/${newer.slug}`)}
                  class="group"
                >
                  <span class="cv-mono text-xs text-neutral-400 dark:text-neutral-500">
                    {t("post.newer")}
                  </span>

                  <span class="mt-2 block text-sm text-neutral-900 underline-offset-4 group-hover:underline dark:text-neutral-100">
                    {newer.entry.data.title}
                  </span>
                </a>
              ) : (
                <span />
              )}

              {older && (
                <a
                  href={localizePath(lang, `/blog/${older.slug}`)}
                  class="group sm:text-right"
                >
                  <span class="cv-mono text-xs text-neutral-400 dark:text-neutral-500">
                    {t("post.older")}
                  </span>

                  <span class="mt-2 block text-sm text-neutral-900 underline-offset-4 group-hover:underline dark:text-neutral-100">
                    {older.entry.data.title}
                  </span>
                </a>
              )}
            </nav>
          )
        }
      </div>

      <!-- Sommaire et sources -->
      <aside
        class="lg:order-2 order-1 lg:sticky lg:top-24 lg:self-start space-y-10"
      >
        {
          toc.length > 1 && (
            <nav aria-label={t("post.tocAria")}>
              <h2 class="cv-mono text-xs sm:text-sm uppercase text-neutral-400 dark:text-neutral-500 mb-4">
                {t("post.toc")}
              </h2>

              <ol class="space-y-3 text-sm">
                {toc.map((heading, index) => (
                  <li class="flex gap-3">
                    <span class="cv-mono shrink-0 text-neutral-300 dark:text-neutral-700">
                      {String(index + 1).padStart(2, "0")}
                    </span>

                    <a
                      href={`#${heading.slug}`}
                      class="toc-link text-neutral-600 underline-offset-4 hover:text-neutral-900 hover:underline dark:text-neutral-300 dark:hover:text-neutral-100"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        {
          post.data.sources.length > 0 && (
            <section>
              <h2 class="cv-mono text-xs sm:text-sm uppercase text-neutral-400 dark:text-neutral-500 mb-4">
                {t("post.sources")}
              </h2>

              <ul class="space-y-3 text-sm">
                {post.data.sources.map((source) => (
                  <li>
                    <a
                      href={source.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-neutral-600 underline underline-offset-4 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
                    >
                      {source.label} ↗
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  // Sommaire actif : surligne la section en cours de lecture.
  //
  // Calcul par position plutôt qu'IntersectionObserver : avec un observateur,
  // rien n'est actif entre deux titres, puisqu'aucun ne traverse la zone
  // observée. Ici, la section active est toujours la dernière franchie.
  const links = document.querySelectorAll<HTMLAnchorElement>(".toc-link");

  if (links.length > 0) {
    const entries = [...links]
      .map((link) => ({
        link,
        heading: document.getElementById(decodeURIComponent(link.hash.slice(1))),
      }))
      .filter(
        (entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } =>
          entry.heading !== null,
      );

    // Hauteur du header flottant : un titre est « franchi » un peu avant
    // d'atteindre le haut de la fenêtre.
    const OFFSET = 120;

    let frame = 0;

    const update = () => {
      frame = 0;

      let active = -1;

      entries.forEach((entry, index) => {
        if (entry.heading.getBoundingClientRect().top <= OFFSET) active = index;
      });

      entries.forEach((entry, index) => {
        entry.link.classList.toggle("toc-link-active", index === active);
      });
    };

    const schedule = () => {
      if (frame === 0) frame = requestAnimationFrame(update);
    };

    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule, { passive: true });

    update();
  }
</script>
