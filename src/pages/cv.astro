---
import BaseLayout from "../layouts/BaseLayout.astro";

type ExperienceProject = {
  name: string;
  description: string;
  tags?: string[];
};

type Experience = {
  role: string;
  company: string;
  contract: string;
  period: string;
  duration: string;
  location: string;
  note?: string;
  tags?: string[];
  softSkills?: string[];
  projects?: ExperienceProject[];
};

type PeriodGroup = {
  label: string;
  items: Experience[];
};

type Education = {
  degree: string;
  school: string;
  link?: string;
};

// Expériences professionnelles
const periods: PeriodGroup[] = [
  {
    label: "2024 — Aujourd'hui",
    items: [
      {
        role: "Développeur Back-end",
        company: "Promatec",
        contract: "CDI",
        period: "sept. 2024 — aujourd'hui",
        duration: "2 ans",
        location: "Bondues, Hauts-de-France",

        projects: [
          {
            name: "Promatec",
            description:
              "Développement et maintenance des outils internes et des solutions web pour les besoins de l'entreprise et de ses clients.",
            tags: ["PHP", "SQL", "API", "JavaScript"],
          },
          {
            name: "MailSecure",
            description:
              "Développement de la solution MailSecure, avec une forte implication sur le développement applicatif, le back-end, les API et l'environnement technique.",
            tags: ["Next.js", "TypeScript", "React", "Docker", "API"],
          },
        ],

        softSkills: [
          "Travail en équipe",
          "Autonomie",
          "Résolution de problèmes",
          "Adaptabilité",
        ],
      },
    ],
  },
  {
    label: "2022 — 2024",
    items: [
      {
        role: "Développeur Back-end",
        company: "Promatec",
        contract: "Alternance",
        period: "sept. 2022 — août 2024",
        duration: "2 ans",
        location: "Bondues, Hauts-de-France",
        tags: ["PHP", "SQL", "Linux / Bash", "API"],
        softSkills: [
          "Travail en équipe",
          "Autonomie",
          "Organisation",
        ],
      },
      {
        role: "Développeur Full-stack",
        company: "Local & Toi",
        contract: "Projet étudiant",
        period: "sept. 2023 — janv. 2024",
        duration: "5 mois",
        location: "Villeneuve-d'Ascq, Hauts-de-France",
        note: "Projet Platine",
        tags: ["Flutter", "Figma"],
        softSkills: [
          "Travail en équipe",
          "Communication",
          "Gestion de projet",
        ],
      },
    ],
  },
  {
    label: "2018 — 2022",
    items: [
      {
        role: "Employé polyvalent",
        company: "Stokomani",
        contract: "Intérimaire",
        period: "juil. 2022 — août 2022",
        duration: "2 mois",
        location: "Lys-lez-Lannoy, Hauts-de-France",
        softSkills: [
          "Relation client",
          "Travail en équipe",
          "Adaptabilité",
          "Organisation",
        ],
      },
      {
        role: "Développeur Web",
        company: "Auto-Entreprise Fabien Pamelard",
        contract: "Stage",
        period: "avr. 2021 — août 2021",
        duration: "5 mois",
        location: "Armentières, Hauts-de-France",
        note: "Stage de fin de Licence",
        tags: ["HTML", "CSS", "JavaScript", "PrestaShop"],
        softSkills: [
          "Autonomie",
          "Communication",
          "Organisation",
        ],
      },
      {
        role: "Auxiliaire de banque",
        company: "Groupe Crédit du Nord",
        contract: "CDD",
        period: "août 2018",
        duration: "1 mois",
        location: "Lumbres, Hauts-de-France",
        note:
          "Expérience renouvelée en août 2019 au Crédit du Nord de Watten, ainsi que des missions d'intérim.",
        softSkills: [
          "Accueil client",
          "Rigueur",
          "Confidentialité",
          "Organisation",
        ],
      },
    ],
  },
];

// Formation
const education: Education[] = [
  {
    degree: "Master — STS, Parcours E-Services, Mention Informatique",
    school: "Université de Lille",
    link: "https://diplome-certificat.univ-lille.fr/index.html?key=D12824758A4F95CAC319D56AFFFD13ED9E29127428FF06E484826448207792D2YXlkMXltWTRCd1J2QXRXMTE1SkFUQzRmWnBTbVFBYjRnNGtQa2Z1UCtJRDl6elBI",
  },
  {
    degree: "Licence — STS, Parcours Informatique",
    school: "Université de Lille",
    link: "https://diplome-certificat.univ-lille.fr/index.html?key=8F449EDDB7A37213CE6EA7553DEFEB993E65F275F47CE06702A419391B056694MkVWYW9uMlFDUHlvY0pTaE9vVkNMcWhBZUkxeTlQSEZqeGJHQXY0RDk0UmlrZzdx",
  },
];

// Liste automatique des compétences techniques
const skillList = [
  ...new Set(
    periods.flatMap((group) =>
      group.items.flatMap((experience) => [
        ...(experience.tags ?? []),
        ...(experience.projects?.flatMap(
          (project) => project.tags ?? [],
        ) ?? []),
      ]),
    ),
  ),
].sort();

// Mélange aléatoire
function shuffle<T>(array: T[]): T[] {
  const result = [...array];

  for (let i = result.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));

    [result[i], result[j]] = [result[j], result[i]];
  }

  return result;
}

/**
 * Chaque skill reçoit une couleur différente.
 *
 * L'ordre des couleurs est aléatoire à chaque rendu.
 * La couleur reste identique partout sur la même page.
 */
const shuffledSkills = shuffle(skillList);

const skillColors = new Map<string, string>();

shuffledSkills.forEach((skill, index) => {
  const hue = Math.round(
    (index * 360) / shuffledSkills.length,
  );

  skillColors.set(
    skill,
    `hsl(${hue} 70% 48%)`,
  );
});

function getSkillColor(skill: string): string {
  return (
    skillColors.get(skill) ??
    "hsl(0 0% 50%)"
  );
}

// Liste automatique des compétences transversales
const softSkillList = [
  ...new Set(
    periods.flatMap((group) =>
      group.items.flatMap(
        (experience) => experience.softSkills ?? [],
      ),
    ),
  ),
].sort();

// Centres d'intérêt
const interests = [
  {
    title: "Musique",
    description:
      "Tubiste au sein de l'Harmonie d'Aire-sur-la-Lys depuis septembre 2010. Batterie et guitare en autodidacte.",
  },
  {
    title: "Sport",
    description:
      "Course à pied, Randonnée, Escalade, Fléchettes",
  },
  {
    title: "Loisirs",
    description:
      "Échecs, Jeux de société, Lecture",
  },
];

// Informations complémentaires
const additionalInfo = [
  {
    title: "Permis",
    description: "Permis B et A2",
  },
  {
    title: "Mobilité",
    description: "Véhiculé",
  },
];
---

<BaseLayout title="CV — Justin Sillou" fullWidth>
  <div
    class="cv-page w-full px-5 sm:px-8 lg:px-16 py-14 sm:py-20 lg:py-28"
  >

    <!-- En-tête -->
    <header class="mb-14 sm:mb-16 lg:mb-24 max-w-3xl">

      <h1
        class="cv-serif text-4xl sm:text-5xl lg:text-6xl text-neutral-900 dark:text-neutral-100"
      >
        CV
      </h1>

      <p
        class="mt-3 sm:mt-4 text-base sm:text-lg text-neutral-500 dark:text-neutral-400"
      >
        Développeur Fullstack — Lille, Hauts-de-France
      </p>

    </header>

    <div
      class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] gap-16 lg:gap-24"
    >

      <!-- Colonne principale -->
      <div class="min-w-0 space-y-20 lg:space-y-24">

        <!-- Expérience -->
        <section>

          <h2
            class="cv-section-title text-xs sm:text-sm uppercase  text-neutral-400 dark:text-neutral-500 mb-10"
          >
            Expérience
          </h2>

          <div class="relative lg:pl-20">

            <!-- Ligne verticale desktop -->
            <div
              class="hidden lg:block absolute left-5 top-4 bottom-4 w-px bg-neutral-200 dark:bg-neutral-800"
            ></div>

            <div class="space-y-14 lg:space-y-16">

              {
                periods.map((group) => (
                  <div class="relative">

                    <!-- Timeline desktop -->
                    <div
                      class="hidden lg:flex absolute -left-20 top-1 w-10 flex-col items-center"
                    >
                      <span
                        class="relative z-10 w-2.5 h-2.5 rounded-full bg-neutral-900 dark:bg-neutral-100"
                      ></span>
                    </div>

                    <!-- Date mobile -->
                    <h3
                      class="lg:hidden cv-section-title text-xs uppercase  text-neutral-400 dark:text-neutral-500 border-b border-neutral-200 dark:border-neutral-800 pb-3 mb-6"
                    >
                      {group.label}
                    </h3>

                    <!-- Date desktop -->
                    <h3
                      class="hidden lg:block cv-serif text-xl lg:text-2xl text-neutral-900 dark:text-neutral-100 border-b border-neutral-200 dark:border-neutral-800 pb-4 mb-8"
                    >
                      {group.label}
                    </h3>

                    <!-- Expériences -->
                    <div
                      class="divide-y divide-neutral-200 dark:divide-neutral-800"
                    >

                      {
                        group.items.map((exp) => (
                          <article
                            class="grid grid-cols-1 sm:grid-cols-[minmax(0,1fr)_auto] gap-x-8 gap-y-4 py-7 sm:py-8 first:pt-0"
                          >

                            <!-- Contenu -->
                            <div class="min-w-0">

                              <h4
                                class="text-base sm:text-lg lg:text-xl font-semibold text-neutral-900 dark:text-neutral-100"
                              >
                                {exp.role}
                              </h4>

                              <p
                                class="text-sm sm:text-base text-neutral-500 dark:text-neutral-400 mt-1"
                              >
                                {exp.company}

                                <span class="hidden sm:inline">
                                  {" "}·{" "}
                                </span>

                                <span class="block sm:inline">
                                  {exp.contract}
                                </span>

                                <span class="hidden sm:inline">
                                  {" "}·{" "}
                                </span>

                                <span class="block sm:inline">
                                  {exp.location}
                                </span>
                              </p>

                              {exp.projects &&
                                exp.projects.length > 0 ? (
                                <div class="mt-6 space-y-5">

                                  {exp.projects.map(
                                    (project, index) => (
                                      <div
                                        class={`experience-project ${
                                          index > 0
                                            ? "pt-5 border-t border-neutral-100 dark:border-neutral-900"
                                            : ""
                                        }`}
                                      >

                                        <div class="flex items-center gap-3">

                                          <span
                                            class="w-1.5 h-1.5 rounded-full bg-neutral-900 dark:bg-neutral-100 shrink-0"
                                          ></span>

                                          <h5
                                            class="cv-section-title text-xs sm:text-sm font-medium uppercase tracking-wide text-neutral-800 dark:text-neutral-200"
                                          >
                                            {project.name}
                                          </h5>

                                          {project.name ===
                                            "MailSecure" && (
                                            <span
                                              class="text-[10px] sm:text-xs cv-mono uppercase  text-neutral-400 dark:text-neutral-500"
                                            >
                                              Produit
                                            </span>
                                          )}

                                        </div>

                                        <p
                                          class="text-sm text-neutral-500 dark:text-neutral-400 mt-2 max-w-2xl leading-relaxed"
                                        >
                                          {project.description}
                                        </p>

                                        {project.tags &&
                                          project.tags.length > 0 && (
                                            <div class="flex flex-wrap items-center gap-x-3 sm:gap-x-4 gap-y-2 mt-3">

                                              {project.tags.map(
                                                (tag) => {
                                                  const color =
                                                    getSkillColor(
                                                      tag,
                                                    );

                                                  return (
                                                    <span
                                                      class="cv-mono inline-flex items-center gap-1.5 sm:gap-2 text-xs sm:text-sm whitespace-nowrap"
                                                      style={`color: ${color}`}
                                                    >
                                                      <span
                                                        class="w-2 h-2 rounded-full shrink-0"
                                                        style={`background-color: ${color}`}
                                                      />

                                                      {tag}
                                                    </span>
                                                  );
                                                },
                                              )}

                                            </div>
                                          )}

                                      </div>
                                    ),
                                  )}

                                </div>
                              ) : (
                                <>
                                  {exp.note && (
                                    <p
                                      class="text-sm text-neutral-400 dark:text-neutral-500 mt-2 max-w-2xl"
                                    >
                                      {exp.note}
                                    </p>
                                  )}

                                  {exp.tags &&
                                    exp.tags.length > 0 && (
                                      <div class="flex flex-wrap items-center gap-x-3 sm:gap-x-4 gap-y-2 mt-4">

                                        {exp.tags.map(
                                          (tag) => {
                                            const color =
                                              getSkillColor(
                                                tag,
                                              );

                                            return (
                                              <span
                                                class="cv-mono inline-flex items-center gap-1.5 sm:gap-2 text-xs sm:text-sm whitespace-nowrap"
                                                style={`color: ${color}`}
                                              >
                                                <span
                                                  class="w-2 h-2 rounded-full shrink-0"
                                                  style={`background-color: ${color}`}
                                                />

                                                {tag}
                                              </span>
                                            );
                                          },
                                        )}

                                      </div>
                                    )}
                                </>
                              )}

                              {exp.projects &&
                                exp.note && (
                                  <p
                                    class="text-sm text-neutral-400 dark:text-neutral-500 mt-4 max-w-2xl"
                                  >
                                    {exp.note}
                                  </p>
                                )}

                              <!-- Soft skills -->
                              {exp.softSkills &&
                                exp.softSkills.length > 0 && (
                                  <div class="flex flex-wrap items-center gap-x-3 sm:gap-x-4 gap-y-2 mt-4">

                                    {exp.softSkills.map(
                                      (skill) => (
                                        <span
                                          class="inline-flex items-center gap-1.5 sm:gap-2 text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 whitespace-nowrap"
                                        >

                                          <span
                                            class="w-1.5 h-1.5 rounded-full bg-neutral-400 dark:bg-neutral-600 shrink-0"
                                          ></span>

                                          {skill}

                                        </span>
                                      ),
                                    )}

                                  </div>
                                )}

                            </div>

                            <!-- Dates -->
                            <div
                              class="cv-mono text-xs sm:text-sm text-neutral-400 dark:text-neutral-500 sm:text-right sm:whitespace-nowrap border-t sm:border-t-0 border-neutral-100 dark:border-neutral-900 pt-3 sm:pt-0"
                            >
                              <p>{exp.period}</p>
                              <p>{exp.duration}</p>
                            </div>

                          </article>
                        ))
                      }

                    </div>

                  </div>
                ))
              }

            </div>
          </div>
        </section>

        <!-- Formation -->
        <section>

          <h2
            class="cv-section-title text-xs sm:text-sm uppercase  text-neutral-400 dark:text-neutral-500 mb-10"
          >
            Formation
          </h2>

          <div
            class="divide-y divide-neutral-200 dark:divide-neutral-800"
          >

            {
              education.map((edu) => (
                <div
                  class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-4 sm:gap-8 py-6 first:pt-0"
                >

                  <div>

                    <h4
                      class="text-base sm:text-lg font-semibold text-neutral-900 dark:text-neutral-100"
                    >
                      {edu.degree}
                    </h4>

                    <p
                      class="text-sm sm:text-base text-neutral-500 dark:text-neutral-400 mt-1"
                    >
                      {edu.school}
                    </p>

                  </div>

                  {edu.link && (
                    <a
                      href={edu.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="cv-mono self-start sm:self-auto text-xs sm:text-sm text-neutral-400 dark:text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 underline underline-offset-4 whitespace-nowrap transition-colors"
                    >
                      Voir le diplôme →
                    </a>
                  )}

                </div>
              ))
            }

          </div>
        </section>

      </div>

      <!-- Sidebar -->
      <aside
        class="lg:sticky lg:top-16 h-fit space-y-12 lg:space-y-14"
      >

        <!-- Stack -->
        <section>

          <h2
            class="cv-section-title text-xs sm:text-sm uppercase  text-neutral-400 dark:text-neutral-500 mb-5"
          >
            Stack
          </h2>

          <ul
            class="flex flex-wrap gap-x-4 gap-y-3 lg:flex-col lg:gap-3"
          >

            {
              skillList.map((skill) => {
                const color = getSkillColor(skill);

                return (
                  <li
                    class="inline-flex items-center gap-2 whitespace-nowrap"
                  >

                    <span
                      class="w-2.5 h-2.5 rounded-full shrink-0"
                      style={`background-color: ${color}`}
                    />

                    <span
                      class="text-xs sm:text-sm"
                      style={`color: ${color}`}
                    >
                      {skill}
                    </span>

                  </li>
                );
              })
            }

          </ul>
        </section>

        <!-- Compétences transversales -->
        <section>

          <h2
            class="cv-section-title text-xs sm:text-sm uppercase  text-neutral-400 dark:text-neutral-500 mb-5"
          >
            Compétences transversales
          </h2>

          <ul
            class="flex flex-wrap gap-x-4 gap-y-3 lg:flex-col lg:gap-3"
          >

            {
              softSkillList.map((skill) => (
                <li
                  class="inline-flex items-center gap-2 whitespace-nowrap"
                >

                  <span
                    class="w-1.5 h-1.5 rounded-full bg-neutral-400 dark:bg-neutral-600 shrink-0"
                  ></span>

                  <span
                    class="text-xs sm:text-sm text-neutral-700 dark:text-neutral-300"
                  >
                    {skill}
                  </span>

                </li>
              ))
            }

          </ul>
        </section>

        <!-- Centres d'intérêt -->
        <section>

          <h2
            class="cv-section-title text-xs sm:text-sm uppercase  text-neutral-400 dark:text-neutral-500 mb-5"
          >
            Centres d'intérêt
          </h2>

          <div class="space-y-4">

            {
              interests.map((interest) => (
                <div>

                  <h3
                    class="text-sm font-medium text-neutral-900 dark:text-neutral-100"
                  >
                    {interest.title}
                  </h3>

                  <p
                    class="text-sm text-neutral-500 dark:text-neutral-400 mt-1 leading-relaxed"
                  >
                    {interest.description}
                  </p>

                </div>
              ))
            }

          </div>
        </section>

        <!-- Informations complémentaires -->
        <section>

          <h2
            class="cv-section-title text-xs sm:text-sm uppercase  text-neutral-400 dark:text-neutral-500 mb-5"
          >
            Informations complémentaires
          </h2>

          <div class="space-y-4">

            {
              additionalInfo.map((info) => (
                <div>

                  <h3
                    class="text-sm font-medium text-neutral-900 dark:text-neutral-100"
                  >
                    {info.title}
                  </h3>

                  <p
                    class="text-sm text-neutral-500 dark:text-neutral-400 mt-1"
                  >
                    {info.description}
                  </p>

                </div>
              ))
            }

          </div>
        </section>

      </aside>
    </div>
  </div>
</BaseLayout>