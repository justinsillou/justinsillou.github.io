---
import BaseLayout from "../layouts/BaseLayout.astro";

const links = [
  { label: "Accueil", href: "/" },
  { label: "Now", href: "/now" },
  { label: "Projets", href: "/projets" },
  { label: "Blog", href: "/blog" },
];
---

<BaseLayout title="Page introuvable — Justin Sillou" noindex>
  <div class="text-center">
    <p class="cv-mono text-xs text-neutral-400 dark:text-neutral-500">404</p>

    <h1 class="mt-3 text-3xl font-bold">Cette page n'existe pas</h1>

    <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400">
      Le lien est peut-être obsolète — le site a été refondu.
    </p>

    <nav class="mt-8 flex flex-wrap justify-center gap-x-5 gap-y-2" aria-label="Pages du site">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="cv-mono text-xs text-neutral-500 underline underline-offset-4 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</BaseLayout>
